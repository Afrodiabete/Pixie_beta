<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FBF8FF</color>
    <color name="ink">#3D2B56</color>
    <color name="muted">#7A6A90</color>
    <color name="accent">#9B7BC4</color>
    <color name="accent_soft">#C7B3E3</color>

    <style name="Theme.Pixie" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/ink</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
